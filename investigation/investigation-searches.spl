/*
SOC-INV-2026-001
Key Splunk searches used during the investigation.
*/


/* 1. Scope Sysmon activity during the incident window */

index=main host="WIN11-DFIR" sourcetype="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational"
earliest="10/04/2026:21:51:00" latest="10/04/2026:21:54:00"
| rex field=_raw "<EventID>(?<EventID>\d+)</EventID>"
| stats count by EventID
| sort 0 + EventID


/* 2. Identify network connections */

index=main host="WIN11-DFIR" sourcetype="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational"
earliest="10/04/2026:21:51:00" latest="10/04/2026:21:54:00"
| rex field=_raw "<EventID>(?<EventID>\d+)</EventID>"
| rex field=_raw "<Data Name='ProcessGuid'>(?<ProcessGuid>[^<]+)"
| rex field=_raw "<Data Name='ProcessId'>(?<ProcessId>[^<]+)"
| rex field=_raw "<Data Name='Image'>(?<Image>[^<]+)"
| rex field=_raw "<Data Name='User'>(?<User>[^<]+)"
| rex field=_raw "<Data Name='Protocol'>(?<Protocol>[^<]+)"
| rex field=_raw "<Data Name='SourceIp'>(?<SourceIp>[^<]+)"
| rex field=_raw "<Data Name='SourcePort'>(?<SourcePort>[^<]+)"
| rex field=_raw "<Data Name='DestinationIp'>(?<DestinationIp>[^<]+)"
| rex field=_raw "<Data Name='DestinationPort'>(?<DestinationPort>[^<]+)"
| search EventID=3
| table _time User Image ProcessId ProcessGuid Protocol SourceIp SourcePort DestinationIp DestinationPort


/* 3. Review file creation */

index=main host="WIN11-DFIR" sourcetype="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational"
earliest="10/04/2026:21:51:00" latest="10/04/2026:21:54:00"
| rex field=_raw "<EventID>(?<EventID>\d+)</EventID>"
| rex field=_raw "<Data Name='ProcessGuid'>(?<ProcessGuid>[^<]+)"
| rex field=_raw "<Data Name='ProcessId'>(?<ProcessId>[^<]+)"
| rex field=_raw "<Data Name='Image'>(?<Image>[^<]+)"
| rex field=_raw "<Data Name='TargetFilename'>(?<TargetFilename>[^<]+)"
| rex field=_raw "<Data Name='User'>(?<User>[^<]+)"
| search EventID=11
| table _time User Image ProcessId ProcessGuid TargetFilename
| sort _time


/* 4. Identify execution of the staged script */

index=main host="WIN11-DFIR" sourcetype="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational"
earliest="10/04/2026:21:51:00" latest="10/04/2026:21:54:00"
| rex field=_raw "<EventID>(?<EventID>\d+)</EventID>"
| rex field=_raw "<Data Name='ProcessGuid'>(?<ProcessGuid>[^<]+)"
| rex field=_raw "<Data Name='ProcessId'>(?<ProcessId>[^<]+)"
| rex field=_raw "<Data Name='Image'>(?<Image>[^<]+)"
| rex field=_raw "<Data Name='CommandLine'>(?<CommandLine>[^<]+)"
| rex field=_raw "<Data Name='User'>(?<User>[^<]+)"
| rex field=_raw "<Data Name='ParentImage'>(?<ParentImage>[^<]+)"
| rex field=_raw "<Data Name='ParentProcessId'>(?<ParentProcessId>[^<]+)"
| search EventID=1 CommandLine="*SOC-INV-2026-001.ps1*"
| table _time User Image ProcessId CommandLine ParentImage ParentProcessId ProcessGuid


/* 5. Investigate account-creation process chain */

index=main host="WIN11-DFIR" sourcetype="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational"
earliest="10/04/2026:21:53:40" latest="10/04/2026:21:53:55"
| rex field=_raw "<EventID>(?<EventID>\d+)</EventID>"
| rex field=_raw "<Data Name='ProcessId'>(?<ProcessId>[^<]+)"
| rex field=_raw "<Data Name='Image'>(?<Image>[^<]+)"
| rex field=_raw "<Data Name='CommandLine'>(?<CommandLine>[^<]+)"
| rex field=_raw "<Data Name='User'>(?<User>[^<]+)"
| rex field=_raw "<Data Name='ParentImage'>(?<ParentImage>[^<]+)"
| rex field=_raw "<Data Name='ParentProcessId'>(?<ParentProcessId>[^<]+)"
| search EventID=1 (Image="*\\net.exe" OR Image="*\\net1.exe")
| eval CommandLine=replace(CommandLine,"SOC-TestUser [^ ]+ /add","SOC-TestUser [REDACTED] /add")
| table _time User Image ProcessId CommandLine ParentImage ParentProcessId
| sort _time
